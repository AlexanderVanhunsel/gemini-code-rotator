# Copy to .env (install.sh does this for you). NEVER commit the real .env.

# One free key per Google Cloud project (https://aistudio.google.com/apikey).
# Keys in the same project share one quota, so they will not rotate usefully.
# Add more by adding GEMINI_API_KEY_4, _5, ... and restarting ./start.sh
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Model used for every key. List what your key can use with ./list-models.sh
GEMINI_MODEL=gemini/gemini-3.8-flash

# Password between your tools (Aider/Cline) and the local proxy.
# install.sh generates a random one. Must start with "sk-".
LITELLM_MASTER_KEY=sk-local-change-me

# Optional: change the proxy port (default 4000)
# PORT=4000
